# Walpapur Tabletop - Spell Service Test Environment Variables
#
# Скопіюйте цей файл як .env.test та заповніть значеннями для тестування
# cp .env.test.example .env.test

# ============================================
# Database Configuration (Test)
# ============================================

# MySQL Root Password (для docker-compose тестування)
DB_ROOT_PASSWORD=test_root_password

# Database Configuration for Testing
SPELLS_DB_HOST=localhost
SPELLS_DB_PORT=3306
SPELLS_DB_USER=spells_test_user
SPELLS_DB_PASSWORD=spells_test_password
SPELLS_DB_NAME=spells_test_db

# ============================================
# Authentication & Security
# ============================================

# JWT Secret Key for Testing
# ВАЖЛИВО: Використовуйте той самий SECRET як в основному .env для тестування!
JWT_SECRET=test_secret_key_minimum_32_characters_long_for_testing

# ============================================
# API Gateway (Test)
# ============================================

# API Gateway Configuration
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
SPELL_SERVICE_URL=http://localhost:3002

# Auth Service
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_USER=auth_test_user
AUTH_DB_PASSWORD=auth_test_password
AUTH_DB_NAME=auth_test_db

# ============================================
# Service Ports (Local Development)
# ============================================

# Порти для локального тестування
PORT_AUTH=3001
PORT_SPELL=3002
PORT_GATEWAY=3000

# ============================================
# Logging & Monitoring (Test)
# ============================================

# Log Level для тестування: debug, info, warn, error
LOG_LEVEL=debug

# ============================================
# Testing Configuration
# ============================================

# Node Environment
NODE_ENV=test

# Jest Configuration
JEST_TIMEOUT=10000
TEST_DATABASE_RESET=true
